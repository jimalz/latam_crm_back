datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model users {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  created_at DateTime @default(now())
}

model customers {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  phone      String?
  created_at DateTime @default(now())
}
